# Required: Groq API key for LLM structured extraction (obtain at https://console.groq.com/keys)
GROQ_API_KEY=your_groq_api_key_here

# Optional: LiteLLM provider/model identifier used by Crawl4AI LLMConfig
LLM_PROVIDER=groq/openai/gpt-oss-120b

# Optional: Default crawler configuration
DEFAULT_START_URL=https://www.theknot.com/marketplace/wedding-reception-venues-atlanta-ga
DEFAULT_MAX_PAGES=3
HEADLESS_BROWSER=true
PAGE_TIMEOUT_MS=60000
REQUEST_DELAY_SECONDS=20.0
